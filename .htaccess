# Enable URL rewriting for clean URLs (requires mod_rewrite on Apache)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Redirect index.php to root first (single redirect)
RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Redirect admin/index.php to /admin/
RewriteCond %{THE_REQUEST} \s/admin/index\.php[\s?] [NC]
RewriteRule ^admin/index\.php$ /admin/ [R=301,L]

# 301 redirect .php URLs to clean URLs (public site, admin, and api)
RewriteCond %{THE_REQUEST} \s/[^.]+\.php [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]

# Redirect /index to root
RewriteCond %{REQUEST_URI} ^/index/?$
RewriteRule ^(.*)$ / [R=301,L]

# Custom forms: /form/client-intake -> form.php?slug=client-intake
RewriteRule ^form/([a-zA-Z0-9_-]+)/?$ form.php?slug=$1 [L,QSA]

# Blog posts: /blog/slug -> blog-post.php?slug=slug
RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-post.php?slug=$1 [L,QSA]

# Dynamic sitemap (includes published blog posts)
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# AI crawler guidance file
RewriteRule ^llms\.txt$ llms.txt [L]

# Public email images (used in campaign / holiday HTML)
RewriteRule ^email-asset/([A-Za-z0-9._-]+)$ email-asset.php?f=$1 [L,QSA]

# Admin dashboard: /admin -> admin/index.php
RewriteRule ^admin/?$ admin/index.php [L]

# API: /api/submit -> api/submit.php
RewriteRule ^api/([a-zA-Z0-9_-]+)/?$ api/$1.php [L,QSA]

# Clean URLs - internally rewrite /page to page.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# SEO redirects
RewriteCond %{REQUEST_URI} ^/home/?$
RewriteRule ^(.*)$ / [R=301,L]

RewriteCond %{REQUEST_URI} ^/contact-us/?$
RewriteRule ^(.*)$ /contact [R=301,L]

RewriteCond %{REQUEST_URI} ^/our-services/?$
RewriteRule ^(.*)$ /services [R=301,L]

RewriteCond %{REQUEST_URI} ^/about-us/?$
RewriteRule ^(.*)$ /about [R=301,L]
</IfModule>

# Custom Error Pages
ErrorDocument 404 /index.php
ErrorDocument 403 /index.php
ErrorDocument 500 /index.php

# Set default charset
AddDefaultCharset UTF-8